{
  "testEnvironment": "node",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleFileExtensions": ["ts", "js", "json", "node"],
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", { "useESM": true }]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}\\/.*)\\.js$": "$1"
  },
  "transformIgnorePatterns": [
    "/node_modules/"
  ]
}

